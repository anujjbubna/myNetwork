{
  "name": "mynetwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && tsx scripts/migrate-to-multiuser.ts && next build",
