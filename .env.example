# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@host:5432/mynetwork"

# 4-8 digit PIN used to unlock the app
APP_PIN="1234"

# Secret used to sign the auth cookie (any long random string)
AUTH_SECRET="generate-a-long-random-string"

# Anthropic API key for the chat assistant (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."
