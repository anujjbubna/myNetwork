# Postgres — Neon recommends BOTH URLs:
# DATABASE_URL = pooled (has "-pooler" in the host) — used by the app at runtime
# DIRECT_URL   = direct (NO "-pooler") — used by prisma migrate
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret (openssl rand -hex 32)
AUTH_SECRET="generate-a-long-random-string"

# Google OAuth Web client
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google account that owns existing / personal network data (normal app user)
OWNER_EMAIL="you@gmail.com"

# Separate ops admin (metrics + invites only) — not a Google account
ADMIN_ID="choose-an-admin-id"
ADMIN_PASSWORD="choose-a-strong-password"

# Anthropic API key
ANTHROPIC_API_KEY="sk-ant-..."

# Optional
# CHAT_MODEL=claude-sonnet-4-5
# LIGHT_MODEL=claude-haiku-4-5
